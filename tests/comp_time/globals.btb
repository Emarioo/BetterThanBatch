@TEST_CASE(global_initialization)

global hoho: i32 = 8
global yas: i32 = hoho

_test yas; 8; // make sure globals are evaluated in order

@TEST_CASE(global_file_io)

#import "Logger"
#import "File"

global file_size: i32 = size_of_file("README.md")

fn size_of_file(path: char[]) -> i32 {
    size: i64 
    f := FileOpen(path, FILE_READ_ONLY, &size)
    FileClose(f)
    return size;
}

fn main() {
    // log("size of README.md: ", file_size)
    _test 0; 0 == file_size; 
}