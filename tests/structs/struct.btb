@TEST_CASE(struct_direct_initializer)

struct App {
    x: i32 = 23;
}

a: App;
_test 23; a.x
a = {}
_test 23; a.x

@TEST_CASE(initializer_with_fncall)
fn non() -> void* { return null }

cwd := Slice<char>{ non() } // triggered assert in x64_gen, Register allocation failed?

struct Core {
    x: i32[4];
    fn in() {
        x = {1,2,cast_unsafe<i64>non(),4}
    }
}

c: Core
c.in()

@TEST_CASE(access)
struct Base {
    mem: i32;
    fn hey() -> i32 {
        return mem; // abreviated access of this.mem
    }
    fn incr() {
        mem = 1 + hey(); // abreviated access of this.hey()
    }
}
base: Base;
*cast<i32*>&base.mem
// Bug 0: Parsing issues, this happens: *& ( (cast<i32*>base) .mem )
//   the member access should happen first though.
base.incr();

struct A {
    n: i32;
}
a: A
p: i32* = &a.n;
*p = 23
_test 23; a.n;

// not implemented yet
