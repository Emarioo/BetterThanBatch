
#import "Logger"
#import "Compiler"

/*
    Disallow relocations for compile time functions that
    are used by runtime functions.
    
    We have a bunch of functions.
    They are put into the executable.
    Some functions call compile time functions and cannot be relocated.
    How do we track them and filter them out?
    
    Keep track of compile time functions with @compiler (ASTFunction::is_compiler_func).
    
    If a tinycode has a relocation to compile time function (library <compiler>), mark it as comp time only.

    
*/

#run {
    u := create_buildunit()
    log("Unit: ", u)

    // I want to link with specific libraries, how?
    // GLFW.btb specifies path libs/glfw/lib-vc2022
    // but that might not be the path i want.
    // u.set_library_path("GLFW", "new_path") // let's use change the path
    
    // u.set_output("game.exe")
}
