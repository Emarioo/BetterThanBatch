_test 3; 1+2;
_test 3; 1- -2;
_test -1; 2-3;
_test 6; -2*-3;
_test 0; 2/3;
_test cast<u32>0x8000_0000; cast<u32>0x3 * cast<u32>0x8000_0000;
_test 0; cast<u32>2/cast<u32>3;
_test 0; cast<u32>2/cast<u32>3;
