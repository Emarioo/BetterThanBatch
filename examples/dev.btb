fn @intrinsic round(v: f32) -> f32;
fn @intrinsic sqrt(v: f32) -> f32;

_test 3; cast<i32>round(3.3);
_test 4; cast<i32>round(3.7);
_test 1; cast<i32>sqrt(1);
_test 1; cast<i32>sqrt(2);
_test 2; cast<i32>sqrt(3.9999999);

_test 0; 0 && 0
