
#import "SoundSystem"
#import "Logger"
#import "OS"

/*
    This isn't loopback from mic to headphones.
    This example captures audio for some seconds and then replays it.
*/

fn main() {
    memory_tracker.init()
    memory_tracker.disabled = false
    InitSoundState()

    log("Speak!")
    
    mic_format: AudioFormat
    InitInputAudioBuffer(0.1, &mic_format)

    log(&mic_format)

    my_format: AudioFormat
    my_format.sample_rate = 44100
    my_format.sample_format = AUDIO_16BIT_PCM
    // my_format.sample_format = AUDIO_32BIT_FLOAT
    my_format.stereo = true
    my_format = mic_format

    buffer: u8[]
    buffer.len = my_format.byte_size_from_duration(3)
    buffer.ptr = Allocate(buffer.len)
    CaptureAudio(buffer, &my_format)

    // WriteWAVFile("yourtalk.wav", &my_format, buffer)

    // Uncomment code if you want to test sound stream with a WAV file
    // wav_sound := LoadSoundFromFile("examples/sound/wav/stereo-32bit-float-48khz.wav")
    // wav_sound := LoadSoundFromFile("examples/sound/wav/stereo-32bit-float.wav")
    // wav_sound := LoadSoundFromFile("examples/sound/wav/stereo-16bit-16khz.wav")
    // wav_impl := sound_state.getSoundRef(wav_sound.handle)
    // buffer.ptr = wav_impl.wav.data
    // buffer.len = wav_impl.wav.data_len
    // my_format = wav_impl.format

    log("Replaying speech.")

    log("Data in buffer ", buffer.len)

    sound := CreateSoundStream("", my_format.byte_size_from_duration(0.1), &my_format)
    
    inst := sound.createInstance()
    inst.play()

    head := 0
    while {
        len := sound.free_bytes_in_buffer()
        // log("Free in buffer ", len)
        if head + len > buffer.len {
            len = buffer.len - head
        }
        impl := sound_state.getSoundRef(sound.handle)
        // log("USER check head ", impl.buffer_head, ", len ", len, " (tail ",impl.buffer_tail,")")
        if len > 0 {
            written := sound.write(buffer.ptr + head, len)
            head += written
        }

        ProcessSound(0.03)

        ProcessSleep(0.005)

        if impl.available_bytes_in_buffer() == 0 {
            break
        }
    }
}

fn CaptureAudio(buffer: u8[], format: AudioFormat*) {
    head := 0

    start_time := StartMeasure()
    while  {
        ProcessSleep(0.016)

        ProcessSound(0.064)

        // bytes := BytesInInputAudioBuffer(format)
        // log("bytes ", bytes)

        // if bytes + head > buffer.len
        //     break

        written := ConsumeInputAudioBuffer(format, buffer, &head, buffer.len)
        // if written == 0 {
        //     break
        // }
        // memcpy(buffer.ptr + head, sound_state.input_buffer.ptr + sound_state.input_buffer_tail, bytes)
        // head += bytes
        // sound_state.input_buffer_tail = sound_state.input_buffer_tail + bytes // assumes no wrap around

        if head == 0 && written != 0 {
            // wrap around means stop
            break
        }

        // Other way to stop is counting
        now := StartMeasure()
        diff := DiffMeasure(now - start_time)
        if diff > 3.5 {
            log("Capture went for 3.5s but we barely got any audio data from mic, data: ", head)
            break
        }
    }
    // log("End ", head, " ", buffer.len)


    // while {
        

    //     bytes = BytesInInputAudioBuffer(format)
    //     if bytes == 0 {
    //         break
    //     }
    // }
    
    // written := ConsumeInputAudioBuffer(format, buffer, &head, buffer.len)

    // bytes := buffer.len
    // if bytes > sound_state.input_buffer_head
    //     bytes = sound_state.input_buffer_head
    // memcpy(buffer.ptr, sound_state.input_buffer.ptr, bytes)
    // log("START ", sound_state.input_buffer_tail, " ", sound_state.input_buffer_head, " buflen ", buffer.len)
    // if bytes > 0 {
    // written := ConsumeInputAudioBuffer(format, buffer, &head, buffer.len)
    // while {
        // log("stiuff ", written)
    // }
    // if head == 0 {
    //     // head looped back around, it's the end
    //     break
    // }
    // }
}
