
#import "Sound"
#import "File"
#import "OS"
#import "Windows"

fn main() {
    // Use Windows PlaySound API. Can only play one sound at a time.
    PlaySound("examples/sound/wav/goodmorning.wav", false)
    ProcessSleep(1.0)
    PlaySound("examples/sound/wav&goodmorning.wav", true)
}

fn PlaySound(file: char[], synchronous: bool = false) {
    res: u32
    if(synchronous)
        res = win32_PlaySound(file.ptr, null, SND_FILENAME)
    else
        res = win32_PlaySound(file.ptr, null, SND_ASYNC | SND_FILENAME)
    if !res {
        log("ERROR: PlaySound, could not find ",file)
    }
}
fn StopSound() {
    win32_PlaySound(null, null, 0)
}