/*
    How to use simple Audio API
*/

#import "Audio"
#import "OS"

fn main() {
    log("Started")

    InitAudioBackend()
    
    device := OpenDefaultOutputAudioDevice()
    
    // err := snd_pcm_prepare(device.pcm_device)
    // log("ERR ",err)
    

    wav: WAVFile*
    if device.format.sample_format == AUDIO_32BIT_FLOAT {
        if device.format.sample_rate == 48000
            wav = ReadWAVFile("examples/sound/wav/stereo-32bit-float-48khz.wav", print = true)
        else
            wav = ReadWAVFile("examples/sound/wav/stereo-32bit-float.wav", print = true)
    } else if device.format.sample_format == AUDIO_16BIT_PCM {
        wav = ReadWAVFile("examples/sound/wav/stereo-16bit.wav", print = true)
    }
    
    log("Device format", &device.format)
    log("Sound format", &wav.format)
    
    if wav.format != device.format {
        log("Audio device and WAV file have different audio formats. Create your own WAV file that matches the format of your device.")
        return
    }
    
    head := 0
    
    frame_delta := device.format.byte_size_from_duration(0.020)

    head += device.write({wav.data + head, device.format.byte_size_from_duration(0.2)})
    
    while {
        tiny := wav.data_len - head
        if tiny > frame_delta
            tiny = frame_delta

        duration := cast<f32>(device.queued_bytes() / device.format.get_frame_size()) / device.format.sample_rate
        log(duration*1000, " ms (duration left)")
        
        written := device.write({wav.data + head, tiny})
        head += written
        
        t := StartMeasure()
        ProcessSleep(0.016) // 16 ms
        log("  (zzz ", StopMeasure(t)*1000, " ms)")
        
        if device.queued_bytes() == 0 && wav.data_len == head
            break
    }
    CleanupAudioBackend()
    
    log("Finished")
}