#import "ALSA"
#import "Audio" // needed for ReadWAVFile
#import "Logger"

#macro CHECK_ERR(S) if err < 0 { log("Error: ", S, " ", snd_strerror(err)) return 1 } else if err != 0 { log("What ", S, " ", err) }

fn main() -> i32 {
    err := 0
    log("Hello")

    // Enumerate devices
    fn print_device(str: char[]) ->  i32 {
        err := 0
        
        ctl: snd_ctl_t*
        err = snd_ctl_open(&ctl, str.ptr, 0)
        CHECK_ERR("snd_ctl_open")
        
        card: snd_ctl_card_info_t*
        err = snd_ctl_card_info_malloc(&card)
        CHECK_ERR("snd_ctl_card_info_malloc")
        
        err = snd_ctl_card_info(ctl, card)
        CHECK_ERR("snd_ctl_card_info")
        
        log("Device ", str)
        log("Device name     ", snd_ctl_card_info_get_name(card))
        log("Device longname ", snd_ctl_card_info_get_longname(card))
        
        snd_ctl_card_info_free(card)
        snd_ctl_close(ctl)
        return 0
    }
    
    print_device("default")
    
    cardn := -1
    while snd_card_next(&cardn) >= 0 && cardn >= 0 {
        s: StringBuilder
        defer s.cleanup()
        appends(s, "hw:",cardn)
        print_device(s)
    }

    // OPEN DEVICE
    device: snd_pcm_t*
    // err = snd_pcm_open(&device, "plughw:0,0".ptr, SND_PCM_STREAM_PLAYBACK, 0)
    err = snd_pcm_open(&device, "default".ptr, SND_PCM_STREAM_PLAYBACK, 0)
    CHECK_ERR("snd_pcm_open")
    
    // SET PARAMATERS (sample rate, format, stereo)
    params: snd_pcm_hw_params_t*
    err = snd_pcm_hw_params_malloc(&params)
    CHECK_ERR("snd_pcm_hw_params_malloc")
    
    err = snd_pcm_hw_params_any(device, params);
    CHECK_ERR("snd_pcm_hw_params_any")
    
    err = snd_pcm_hw_params_set_access(device, params, SND_PCM_ACCESS_RW_INTERLEAVED);
    CHECK_ERR("snd_pcm_hw_params_set_access")
    
    err = snd_pcm_hw_params_set_format(device, params, SND_PCM_FORMAT_S16_LE)
    CHECK_ERR("snd_pcm_hw_params_set_format")
    
    sample_rate: u32 = 44100
    err = snd_pcm_hw_params_set_rate_near(device, params, &sample_rate, null)
    CHECK_ERR("snd_pcm_hw_params_set_rate_near")
    
    err = snd_pcm_hw_params_set_channels(device, params, 2)
    CHECK_ERR("snd_pcm_hw_params_set_channels")
    
    err = snd_pcm_hw_params(device, params);
    CHECK_ERR("snd_pcm_hw_params")
    
    print_format(params)
    
    // PLAY SOUND
    snd_pcm_prepare(device)
    play_sound(device)
    snd_pcm_drain(device)

    // CLEANUP    
    snd_pcm_hw_params_free(params)
    snd_pcm_close(device)
    
    log("Finished")
    return 0
}

fn play_sound(device: snd_pcm_t*) {
    path := "examples/sound/wav/stereo-16bit.wav"
    log("Reading ", path)
    wav, err := ReadWAVFile(path, true)
    if err != WAV_SUCCESS {
        // error was printed
        return   
    }
    
    // We opened the device for 16-bit 44.1 kHz stereo so we can only play that format if we want to avoid mixing and conversion
    Assert(wav.format.sample_format == AUDIO_16BIT_PCM)
    Assert(wav.format.sample_rate == 44100)
    Assert(wav.format.stereo)
    
    written := snd_pcm_writei(device, wav.data, wav.data_len / wav.format.get_frame_size())
    log("Written frames: ", written)
}

fn print_format(params: snd_pcm_hw_params_t*) -> i32 {
    err := 0
    format: snd_pcm_format_t
    err = snd_pcm_hw_params_get_format(params, &format)
    CHECK_ERR("snd_pcm_hw_params_get_format")
    log("Format: ", &format)
    
    sample_rate: u32
    err = snd_pcm_hw_params_get_rate(params, &sample_rate, null)
    CHECK_ERR("snd_pcm_hw_params_get_rate")
    log("Sample rate: ", &sample_rate)
    
    channels: u32
    err = snd_pcm_hw_params_get_channels(params, &channels)
    CHECK_ERR("snd_pcm_hw_params_get_channels")
    log("Channels: ", &channels)   
    
    return 0
}