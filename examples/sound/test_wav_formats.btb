
#import "Sound"
#import "Logger"
#import "OS"
#import "Array"
fn main() {
    memory_tracker.init()
    memory_tracker.disabled = false
    InitSoundState()

    sounds: Array<char[]>
    sounds.add("examples/sound/wav/mono-8bit.wav")
    sounds.add("examples/sound/wav/mono-16bit.wav")
    // sounds.add("examples/sound/wav/mono-24bit.wav") // We don't support 24-bit PCM
    sounds.add("examples/sound/wav/mono-32bit.wav")
    sounds.add("examples/sound/wav/stereo-16bit.wav")
    sounds.add("examples/sound/wav/stereo-32bit-float.wav")
    sounds.add("examples/sound/wav/stereo-16bit-16khz.wav")

    for sounds {
        ref, err := LoadSoundFromFile(*it)
        Assert(err == SOUND_SUCCESS)

        inst := ref.createInstance()
        log("Playing ", *it)
        
        inst.play()
        while inst.isPlaying() {
            ProcessSound()
            ProcessSleep(0.016)
        }
    }
    log("Finished")
}
