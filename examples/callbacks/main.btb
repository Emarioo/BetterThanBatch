/*
    btb examples/callbacks/main.btb -r
*/

#import "Logger"

#load "./examples/callbacks/util.dll" as util

fn @import(util) set_callback(f: void*)

fn @import(util) call_func4f(a: f32,b:f32,c:f32,d:f32) -> f32
// fn @import(util) call_func9f(a: f32,b:f32,c:f32,d:f32,e:f32,f:f32,g:f32,h:f32,i:f32) -> i32
