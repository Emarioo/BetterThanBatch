// fn @stdcall some_func9f(a: f32, b: f32, c: f32, d: f32, e: f32,f:f32,g:f32,h:f32,i:f32) -> i32 {
//     return a+b+c+d+e+f+g+h+i
// }
fn @stdcall some_func4f(a: f32, b: f32, c: f32, d: f32) -> f32 {
    return a+b+c+d
}
