// Compile GameCore instead of main if you don't want hotreloading

/*
    A dungeon crawler game

    - Multiplayer (local and online co-op)
    - Handmade levels + random generated dungeon
    - Tile-based world
    - Entities with velocity, effects, collision
*/

#import "Hotreloading"
#import "OS"

fn main(argc: i32, argv: char**) -> i32 {
    app: AppInstance
    app.argc = argc
    app.argv = argv
    app.rebuild_cmd.append("btb examples/crawler/GameCore -d --stable-globals --silent --incremental -o ")
    // app.rebuild_cmd.append("btb examples/crawler/GameCore -d --stable-globals --incremental -o ")
    // app.rebuild_cmd.append("btb examples/crawler/GameCore -d --silent --incremental -o bin/code.dll")
    // app.rebuild_cmd.append("btb examples/crawler/GameCore -d --incremental -o bin/code.dll")

    #if OS_WINDOWS
        app.rebuild_cmd.append("bin/code.dll")
        app.init("bin/code.dll")
    #else
        app.rebuild_cmd.append("bin/code.so")
        app.init("bin/code.so")
    #endif
    
    // Load libraries to make sure they never unload when
    // we reload game code, their global data will be reset otherwise.
    // Ideally, we would have a list of all libraries the game relies on
    // but. I have hardcoded them for the time being.
    #if OS_WINDOWS
    #macro DLL_EXT(S) S ## ".dll"
    #else OS_LINUX
    #macro DLL_EXT(S) "lib" ## S ## ".so"
    #endif
    lib0 := LoadDynamicLibrary(DLL_EXT("glad"), log_error = false)
    if !lib0.valid() {
        log(LOG_YELLOW, "WARNING:",LOG_NO_COLOR," Could not load glad.dll, copy dll to local directory from libs/glad/lib-mingw-w64/glad.dll, or libs/glad/lib-ubuntu/glad.dll if you are on Linux (probably works on other distros than Ubuntu).")
        log("  If dll is missing from libs then run build.py. It will compile vendor libraries.")
    }
    lib1 := LoadDynamicLibrary(DLL_EXT("glfw"), log_error = false)
    if !lib1.valid() {
        log(LOG_YELLOW,"WARNING:",LOG_NO_COLOR," Could not load glfw3.dll, copy dll to local directory from libs/glfw3/lib-mingw-w64/glfw3.dll, or libs/glfw3/lib-ubuntu/glfw3.dll if you are on Linux (probably works on other distros than Ubuntu).")
        log("  If dll is missing from libs then run build.py. It will compile vendor libraries.")
    }
    lib2 := LoadDynamicLibrary(DLL_EXT("stb_image"), log_error = false)
    if !lib2.valid() {
        log(LOG_YELLOW,"WARNING:",LOG_NO_COLOR," Could not load stb_image.dll, copy dll to local directory from libs/stb_image/lib-mingw-w64/stb_image.dll, or libs/stb_image/lib-ubuntu/stb_image.dll if you are on Linux (probably works on other distros than Ubuntu).")
        log("  If dll is missing from libs then run build.py. It will compile vendor libraries.")
    }
    yes := StartInfiniteLoop(app)

    if !yes
        return 1
    return 0
}

