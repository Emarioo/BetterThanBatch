/* Build with:
    bin\btb examples/dev2 -d -o bin/math.dll
    bin\btb examples/dev2 -d -o main.exe -r
*/  
#import "Logger"

fn @export glfwCreateWindow(width: i32, height: i32, title: char*, monitor: void*, share: void*) -> void* {
    log("w ",width, " h ",height, " ", title, " ", monitor, " ",share)
    return cast_unsafe<void*>cast<i64>5
}

