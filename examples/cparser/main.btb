/*
    This example shows that you can import C headers and call functions from them.

    This includes functions from the C standard library, your own C headers and
    other popular C libraries like GLFW, Opus, OpenSSL.

    NOTE: Functions with variadic arguments are not supported. Such as printf.
*/

#run {
    #import "OS"

    // Automatically compile 'util.lib'
    ExecuteCommand("gcc -g -c -o util.o util.c")
    ExecuteCommand("ar rcs util.lib util.o")
}

#import "Logger"

// ---------------------

#import "stdlib.h"

num: i32 = atoi("-255".ptr)
log("atoi: ", num)

// ---------------------

#load "./util.lib"
#import "./util.h"

x: i32 = calculate(1, 5)
log("calculte: ", x)
