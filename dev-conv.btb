#if ! GLAPI
   # if GLAD_GLAPI_EXPORT
       # if _WIN32|| __CYGWIN__
           # if GLAD_GLAPI_EXPORT_BUILD
               # if __GNUC__
                    #macro GLAPI @export
                #else
                    #macro GLAPI @export
                #endif
            #else
               # if __GNUC__
                    #macro GLAPI @import(LIB_GLAPI)
                #else
                    #macro GLAPI @import(LIB_GLAPI)
                #endif
            #endif
       # elif __GNUC__&& GLAD_GLAPI_EXPORT_BUILD
            #macro GLAPI @export
        #else
            #macro GLAPI @import(LIB_GLAPI)
        #endif
    #else
        #macro GLAPI @import(LIB_GLAPI)
