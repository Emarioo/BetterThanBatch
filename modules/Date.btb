/*
    This module features some date and time functions:
        DateUTCNow()
        DateLocalNow()
        DateTimeToEpochSeconds()
        EpochSecondsToDateTime()
        DayOfWeek()
        WeekNumber()
    
    This module is based one ISO 8601 and Europe standards for date and time.
    All calculations and seconds passed to functions are based from the UNIX timestamp (1970 jan 1)
*/

#if OS_WINDOWS
    #import "windows/Windows"
#elif OS_LINUX
    #import "linux/Linux"
    #import "vendor/LibC" // we need localtime_r (it deals with timezones, to implement ourselves we need to parse /etc/localtime)
#endif

#import "Logger"
#import "Asserts"

struct DateTime {
    // TODO: We have a bug with returning structs so we can't have i8 fields because push instructions would overwite the return value space (betcall is a flawed calling convention)
    // TODO: nanosecond should be last field but it's first so that year isn't affected by the return struct bug. We want year first because: dt: DateTime = {2025, 06, 17}
    nanosecond: i32;

    year: i32;
    month: i32 = 1;
    day: i32 = 1;
    hour: i32;
    minute: i32;
    second: i32;
}

/*
    DateTime can have nanosecond precision but Windows has 100ns precision at best.
    Linux has potential for nanosecond precision.
*/
fn DateUTCNow(out: DateTime*) {
    second: i64
    nanosecond: i64;

    #if OS_WINDOWS
        filetime: FILETIME
        GetSystemTimePreciseAsFileTime(&filetime)
        time_100ns: u64 = *cast<i64*>&filetime
        SECONDS_BETWEEN_1600_AND_1970: u64 = 11644473600 // = 134774 × 86400 (days * seconds)
        second = time_100ns / 10_000_000u - SECONDS_BETWEEN_1600_AND_1970
        nanosecond = (time_100ns % 10_000_000u) * 100u
    #elif OS_LINUX
        spec: timespec
        clock_gettime(CLOCK_REALTIME, &spec)
        second = spec.tv_sec
        nanosecond = spec.tv_nsec
    #endif
    
    datetime := EpochSecondsToDateTime(second)
    datetime.nanosecond = nanosecond
    ;*out = datetime

    // Extra precaution, should remove in the future
    check_seconds := DateTimeToEpochSeconds(&datetime)
    Assert(check_seconds == second)
}

fn DateLocalNow(out: DateTime*) {
    #if OS_WINDOWS
        systemtime: SYSTEMTIME
        GetLocalTime(&systemtime)
        out.year = systemtime.wYear
        out.month = systemtime.wMonth
        out.day = systemtime.wDay
        out.hour = systemtime.wHour
        out.minute = systemtime.wMinute
        out.second = systemtime.wSecond
        out.nanosecond = systemtime.wMilliseconds * 1000000u // TODO: Use GetLocalTime and GetSystemTimePreciseAsFileTime to get more precise local time.
    #elif OS_LINUX
        now := time(null)
        local_time: tm
        localtime_r(&now, &local_time)
        out.year = local_time.tm_year + 1900
        out.month = local_time.tm_mon + 1
        out.day = local_time.tm_mday
        out.hour = local_time.tm_hour
        out.minute = local_time.tm_min
        out.second = local_time.tm_sec
        out.nanosecond = 0 // TODO: Get nanoseconds from clock_gettime?
    #endif
}

fn EpochSecondsToDateTime(seconds: i64) -> DateTime {
    Assert(seconds >= 0)
    datetime: DateTime
    datetime.second = seconds % 60
    datetime.minute = (seconds/60) % 60
    datetime.hour   = (seconds/(60*60)) % 24

    // log("seconds ",seconds)
    days: i64 = seconds / (60*60*24)

    // Approximate year using average length (365.2425 days/year)
    approx_year: i32 = 1970 + (days * 400) / 146097
    while {
        start: i64 = days_until_year(approx_year)
        next:  i64 = days_until_year(approx_year + 1)
        if days < start
            approx_year -= 1
        else if days >= next
            approx_year += 1
        else
            break
    }
    datetime.year = approx_year // no longer an approximation
                                //     31, 28, 31, 30,  31,  30,  31,  31,  30,  31,  30,  31
    CUMULATIVE_DAYS_IN_MONTH: i32[13] { 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334, 365 }

    days_left: i32 = days - days_until_year(approx_year)
    approx_month: i32 = days_left / 30
    if approx_month >= 12
        approx_month = 11
    // log("days for year ",days_until_year(approx_year))
    // log("days ",days)
    // log("daysleft ",days_left)
    while {
        cumulative_days0 := CUMULATIVE_DAYS_IN_MONTH[approx_month]
        cumulative_days1 := CUMULATIVE_DAYS_IN_MONTH[approx_month+1]
        // log("apr ",approx_month, " ", cumulative_days0, " ",cumulative_days1)
        if is_leap_year(approx_year) && approx_month   > 1  cumulative_days0++
        if is_leap_year(approx_year) && approx_month+1 > 1  cumulative_days1++
        if days_left < cumulative_days0
            approx_month--
        else if days_left >= cumulative_days1
            approx_month++
        else
            break
    }
    // +1 so we go from 1-12 not 0-11
    datetime.month = 1 + approx_month // no longer an approximation
    
    cumulative_days := CUMULATIVE_DAYS_IN_MONTH[approx_month]
    if is_leap_year(approx_year) && approx_month > 1  cumulative_days++

    // +1 so we go from 1-31 not 0-30
    datetime.day = 1 + days_left - cumulative_days
    return datetime
}

fn DateTimeToEpochSeconds(datetime: DateTime*) -> i64 {
    // TODO: Check that datetime has valid year, month, day, hour, minute, second.
    //   Return -1, ERROR if not?
    CUMULATIVE_DAYS_IN_MONTH: i32[13] { 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334, 365 }
    days: i64 = CUMULATIVE_DAYS_IN_MONTH[datetime.month-1]
    if is_leap_year(datetime.year) && datetime.month > 2
        days++

    days += datetime.day - 1

    days += days_until_year(datetime.year)

    return days * 24*60*60 +
        datetime.hour * 3600 +
        datetime.minute * 60 +
        datetime.second
}

enum Weekday {
    MONDAY = 0,
    TUESDAY,
    WEDNESDAY,
    THURSDAY,
    FRIDAY,
    SATURDAY,
    SUNDAY,
}
fn DayOfWeek(dt: DateTime*) -> Weekday {
    days_since_epoch := DateTimeToEpochSeconds(dt)/(24*60*60)
    return cast_unsafe<Weekday>((cast<i32>days_since_epoch + 3) % 7)
}

// returns 1-53
fn WeekNumber(dt: DateTime*) -> i32 {
    days_since_epoch := DateTimeToEpochSeconds(dt)/(24*60*60)
    jan1 := DateTime{ year = dt.year }
    jan1_weekday := cast_unsafe<i32>DayOfWeek(&jan1)
    days_from_start_of_year := days_since_epoch - days_until_year(dt.year)

    fn max_week(year: i32) -> i32 {
        jan1  := DateTime{year=year}
        dec31 := DateTime{year=year, month=12, day=31}
        jan1_weekday := DayOfWeek(&jan1)
        dec31_weekday := DayOfWeek(&dec31)
        if jan1_weekday == THURSDAY || (dec31_weekday == FRIDAY && is_leap_year(year))
            return 53
        return 52
    }

    week: i32 = 0
    if jan1_weekday > 3 { // 3 = thursday
        maxweek := max_week(dt.year-1)
        week = maxweek + (days_from_start_of_year + jan1_weekday) / 7
        if week > maxweek
            return week - maxweek // first week of next year
    } else {
        week = (7 + days_from_start_of_year + jan1_weekday) / 7
        if week > max_week(dt.year)
            return 1 // first week of next year
    }

    // log("days ", days_since_epoch)
    // log("jan1_weekday ", jan1_weekday)
    // log("days_in_year ", days_from_start_of_year)
    // log("adj ", adj)
    // log("week ", week)

    return week
}

/*########################
        MINI FUNCTIONS
##########################*/

fn is_leap_year(year: i32) -> bool {
    return ((year % 4 == 0) && ((year % 100 != 0)) || (year % 400 == 0))
}
    
fn leap_years_before(year: i32) -> i32 {
    y1 := year - 1
    // log(year, " _ ", y1 / 4, " ", y1 / 100," ", y1 / 400)
    return y1 / 4 - y1 / 100 + y1 / 400
}

fn days_until_year(year: i32) -> i64 {
    years: i64 = year - 1970
    // leap_days: i64 = leap_years_before(year)
    leap_days: i64 = leap_years_before(year) - leap_years_before(1970)
    // log(year, " ", leap_days)
    return years * 365 + leap_days
}

fn std_print(datetime: DateTime*) {
    if datetime.year < 10
        std_print("0")
    std_print(datetime.year)
    std_print("-")
    if datetime.month < 10
        std_print("0")
    std_print(datetime.month)
    std_print("-")
    if datetime.day < 10
        std_print("0")
    std_print(datetime.day)
    std_print(" ")
    if datetime.hour < 10
        std_print("0")
    std_print(datetime.hour)
    std_print(":")
    if datetime.minute < 10
        std_print("0")
    std_print(datetime.minute)
    std_print(":")
    if datetime.second < 10
        std_print("0")
    std_print(datetime.second)
    if datetime.nanosecond != 0 {
        val := datetime.nanosecond/1000_000
        if val < 10
            std_print(".00")
        else if val < 100
            std_print(".0")
        else
            std_print(".")
        std_print(val)
    }
}

/*##########################
        TESTING
###########################*/

fn test_date() {
    DPS: i64 = 24*60*60

    #macro CHECK(X, y, m, d)
    {
        dt := EpochSecondsToDateTime((X) * DPS)
        if dt.year == y && dt.month == m && dt.day == d {
            log(LOG_GREEN, "PASS ",LOG_NO_COLOR, X, " -> ", &dt)
            // _test 1; 1;
        } else {
            log(LOG_RED, "FAIL ",LOG_NO_COLOR, X, " !-> ", &dt)
            // _test 1; 0;
        }
    }
    #endmacro

    // CHECK(0,       1970, 1,  1)    // Unix epoch start
    // CHECK(1,       1970, 1,  2)
    // CHECK(365,     1971, 1,  1)    // One non-leap year later
    // CHECK(730,     1972, 1,  1)    // Two years later, 1972 is leap year
    // CHECK(789,     1972, 2, 29)    // Leap day in 1972
    // CHECK(790,     1972, 3,  1)
    // CHECK(1096,    1973, 1,  1)    // Year after leap year
    // CHECK(10957,   2000, 1,  1)    // 2000 leap year (divisible by 400)
    // CHECK(19159,   2022, 6,  16)   // Random recent date (June 15, 2022)
    // CHECK(20256,   2025, 6,  17)   // Today, June 17, 2025
    // CHECK(47541,   2100, 3,  1)    // 2100 is NOT leap year (century rule)

    #macro CHECKW(y, m, d, X)
    {
        dt := DateTime{year=y,month=m,day=d}
        week := WeekNumber(&dt)
        if week == X {
            log(LOG_GREEN, "PASS ",LOG_NO_COLOR, &dt, " -> ", week)
            // _test 1; 1;
        } else {
            log(LOG_RED, "FAIL ",LOG_NO_COLOR, &dt, " !-> ", week)
            // _test 1; 0;
        }
    }
    #endmacro

    CHECKW(2024, 12, 22, 51)
    CHECKW(2024, 12, 23, 52)
    CHECKW(2024, 12, 24, 52)
    CHECKW(2024, 12, 25, 52)
    CHECKW(2024, 12, 26, 52)
    CHECKW(2024, 12, 27, 52)
    CHECKW(2024, 12, 28, 52)
    CHECKW(2024, 12, 29, 52)
    CHECKW(2024, 12, 30,  1)
    CHECKW(2025, 1, 1,  1)
    CHECKW(2025, 1, 2,  1)
    CHECKW(2025, 1, 3,  1)
    CHECKW(2025, 1, 4,  1)
    CHECKW(2025, 1, 5,  1)
    CHECKW(2025, 1, 6,  2)

    CHECKW(2000, 3, 5,  9)
    CHECKW(2000, 3, 6,  10)
    CHECKW(2001, 5, 6,  18)
    CHECKW(2001, 5, 7,  19)
    CHECKW(2006, 12, 31, 52)
    CHECKW(2007, 1, 1,  1)
    CHECKW(2007, 12, 30,  52)
    CHECKW(2007, 12, 31,  1)
    CHECKW(2009, 12, 27,  52)
    CHECKW(2009, 12, 28,  53)
    CHECKW(2010, 1, 3,  53)
    CHECKW(2010, 1, 4,  1)

// CHECK(-25567,  1900, 1,  1)    // Before Unix epoch, 1900 not leap year
    
    // #undef CHECK
}

fn test_range_days(verbose: bool = false) {
    DPS: i64 = 24*60*60
    start_date: DateTime = { year = 2000, month = 1, day = 1 }
    end_date: DateTime = { year = 2025, month = 12, day = 31 }
    start_day := DateTimeToEpochSeconds(&start_date) / DPS
    end_day   := DateTimeToEpochSeconds(&end_date) / DPS
    log("Day range: ",start_day, " to ", end_day)
    for day : start_day..end_day + 1 {
        dt := EpochSecondsToDateTime(day * DPS)
        back := DateTimeToEpochSeconds(&dt) / DPS
        weekday := DayOfWeek(&dt)
        if back != day {
            log("FAIL ",day," → ",&dt, " ", &weekday, " W.", WeekNumber(&dt))
        } else if verbose {
            log("ok ", day, " → ", &dt, " ", &weekday, " W.", WeekNumber(&dt))
        }
    }

    log("Date conversion test complete.")
}