        Assert(false);
    } else {
        // TODO: Look at LoadSoundFromFile
        Assert(false);
    }
    
    return {-1}, SOUND_UNSUPPORTED_FILE_FORMAT
}

fn CreateSoundInstance(ref: SoundRef*) -> SoundInstance {
    Assert(sound_state)


