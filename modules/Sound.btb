/*######################
        WAV File
#######################*/

enum WAVError {
    WAV_SUCCESS,
    WAV_CORRUPT,
    WAV_FILE_NOT_FOUND,
}

#macro WAVFILE_HEADER_SIZE 44

struct WAVFile {
    // IMPORTANT: IF YOU CHANGE STUFF HERE YOU NEED TO CHANGE STUFF IN EXAMPLES. One of them is: sample_wasapi.btb 
    audio_format: u16;
    channels: u16;
    sample_rate: u32;
    byte_rate: u32;
    block_align: u16; // bits_per_sample * channels
    bits_per_sample: u16;

    data: u8*;
    data_len: i32;
}

// returns true if correct RIFF and WAVE fields are found.
fn CheckWAVHeader(file_data: u8[]) -> bool {
    char_ptr := cast<char*>file_data.ptr

    if data.len < WAVFILE_HEADER_SIZE // .wav files should be at least 44 in size
        return false

    if !equal(char_ptr + 0, "RIFF".ptr, 4)
        return false

    if !equal(char_ptr + 8, "WAVE".ptr, 4)
        return false

    return true
}

// TODO: Argument to pass in allocator
// @param path only used when printing error
fn ParseWAVHeader(data: u8[], print: bool = false, path: char[] = "unknown") -> WAVFile*, WAVError {
    head := 0
    char_ptr := cast<char*>data.ptr

    if data.len < WAVFILE_HEADER_SIZE {
        if print
            log("ParseWAVData: Size of data is too small for WAV header (was ",data.len, " needs to be at least 44), origin path = ",path)
        return null, WAV_CORRUPT
    }
    
    if !equal(char_ptr + head, "RIFF".ptr, 4) {
        if print
            log("ParseWAVData: 'RIFF' magic incorrect (was ",Slice<char>{char_ptr+head,4},"), origin path = ",path)
        return null, WAV_CORRUPT
    }
    head += 4

    almost_file_size := *cast<i32*>(data.ptr + head)
    head += 4

    if data.len < almost_file_size + 8 {
        if print
            log("ParseWAVData: File size in header was ",almost_file_size," bytes which does not match size of passed in data of ",data.len,"-8 (-8 because RIFF and file size field are excluded), origin path = ",path)
        return null, WAV_CORRUPT
    }

    if !equal(char_ptr + head, "WAVE".ptr, 4) {
        if print
            log("ParseWAVData: 'WAVE' marker incorrect (was ",Slice<char>{char_ptr+head,4},"), origin path = ",path)
        return null, WAV_CORRUPT
    }
    head += 4

    // TODO: Can WAV files have multiple format and data chunks? If so handle it.

    if !equal(char_ptr + head, "fmt ".ptr, 4) {
        if print
            log("ParseWAVData: 'fmt ' marker incorrect (was ",Slice<char>{char_ptr+head,4},"), origin path = ",path)
        return null, WAV_CORRUPT
    }
    head += 4

    format_size := *cast<i32*>(data.ptr + head)
    head += 4

    if format_size != 16 { // always 16 for WAVE (i think)
        if print
            log("ParseWAVData: Size of format was ",format_size," bytes but should be 16 (probably?), origin path = ",path)
        return null, WAV_CORRUPT
    }

    success := false
    wav: WAVFile* = Allocate(sizeof(WAVFile))
    construct(wav)
    defer if !success DestroyWAVFile(wav)

    wav.audio_format    = *cast<u16*>(data.ptr + head)
    wav.channels        = *cast<u16*>(data.ptr + head + 2)
    wav.sample_rate     = *cast<u32*>(data.ptr + head + 4)
    wav.byte_rate       = *cast<u32*>(data.ptr + head + 8)
    wav.block_align     = *cast<u16*>(data.ptr + head + 12)
    wav.bits_per_sample = *cast<u16*>(data.ptr + head + 14)
    head += 16

    if !equal(char_ptr + head, "data".ptr, 4) {
        if print
            log("ParseWAVData: 'data' marker incorrect (was ",Slice<char>{char_ptr+head,4},"), origin path = ",path)
        return null, WAV_CORRUPT
    }
    head += 4

    wav.data_len = *cast<u32*>(data.ptr + head)
    head += 4

    if(cast<u32>wav.data_len % wav.block_align != 0) {
        if print
            log("ParseWAVData: Size of data should be divisible by block_align (",wav.data_len," % ",wav.block_align,"=",(cast<u32>wav.data_len%wav.block_align),"), origin path = ",path)
        return null, WAV_CORRUPT
    }

    success = true // so we don't defer and destroy WAV file
    return wav, WAV_SUCCESS
}
// If error is returned don't forget to destroy WAVFile returned by ParseWAVHeader
// @param data slice should directly point at data section in WAV file (WAVFILE_HEADER_SIZE from start)
fn ParseWAVData(data: u8[], wav: WAVFile*,  print: bool = false, path: char[] = "unknown") -> WAVError {
    if data.len < wav.data_len {
        if print
            log("ParseWAVData: Data section size was ",wav.data_len," bytes which is to large, expected no more than ",data.len," bytes, origin path = ",path)
        return WAV_CORRUPT
    }

    wav.data = Allocate(wav.data_len)
    Assert(wav.data)
    memcpy(wav.data, data.ptr, wav.data_len)

    return WAV_SUCCESS
}

fn DestroyWAVFile(wav: WAVFile*) {
    if wav.data
        Free(wav.data, wav.data_len)
    Free(wav, sizeof(WAVFile))
}

// IMPORTANT: DO NOT MODIFY THE SIGNATURE OR NAME OF THIS FUNCTION. It is used by examples (sample_wasapi.btb).
//   You can change the internals as long as the function returns WAVFile with WAV data.
fn ReadWAVFile(path: char[], print: bool = false) -> WAVFile*, WAVError {
    data, yes := ReadWholeFile(path)
    if !yes {
        if print
            log("ReadWAVFile: Could not read ", path)
        return null, WAV_FILE_NOT_FOUND
    }
    wav, err := ParseWAVHeader(Slice<u8>{cast<u8*>data.ptr, data.len}, print, path)
    if wav {
        err = ParseWAVData(Slice<u8>{cast<u8*>data.ptr + WAVFILE_HEADER_SIZE, data.len - WAVFILE_HEADER_SIZE}, wav, print, path)
        if err != WAV_SUCCESS {
            DestroyWAVFile(wav)
        }
    }
    return wav, err
}


/*###############################
     Implementation Decisions
#################################

# WHY SoundRef AND SoundInstance

We have SoundRef and SoundInstance because you may want to load a item collect sound
and play it simultaneously. If we just had SoundRef you would load the sound and call play
but what happens if you call play again? Do we stop the current sound that is playing, well no.
Sure we could internal create a new instance of the sound but from a developers view it's just SoundRef.
Problem is that the sound may be a NPC voice which you want to pause when player presses escape.
To pause the sound we need to know which sound we're pausing and we may not want to pause all sounds.

Ultimately we have SoundRef.play_once() for coin collect sounds and SoundRef.create_instance() with more
control for NPC voice sound.

# WHY SoundRef and SoundRef_impl

This is not about hiding implementation details (if I cared about that structs would have private and public fields).
The reasoning behind this is SoundRef not being a pointer meaning that you can call cleanup on it and the data in SoundRef
will be reset. Next time you call a method on it will Assert or do nothing.

With a pointer where allocate and free it you may call cleanup and forget to throwaway the pointer. By having SoundRef as non-pointer that refers to some allocated memory for SoundRef_impl we have more control and options and less error prone.

# WHY ONLY WAV?

Audio files are complex and hard to implement and the documentation on them is somewhat lacking. Therefore you need to use a library for them. But also, I doubt we would be able to implement a better ogg or mp3 decoder than what popular libraries do 
so you probably want to use a library anyway.

# WHY IS 0 as SoundRef.handle VALID AND -1 IS INVALID?

Over the years I have made systems use 0 as handle which is problematic since it is a valid index.
Either you have an array where the first element is unused or when accessing the array you do 'handle-1' and
when creating handles 'handle+1'. This is awful to keep track of so unused first element is best. I have also used -1
to indicate invalid handle which is problematic because you can't reset structs, elements and arrays which contain handles
to zero since that means a valid handle.

This time I have chosen -1 as invalid handle.

*/