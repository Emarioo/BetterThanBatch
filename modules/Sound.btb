    fn init_device() {
        res: i32;

        res = device.vtable.Activate(device, &IAudioClient_GUID, CLSCTX_ALL, null, &audioClient)
        CHECK_HR
        WASLOG("pass device.Activate")

        res = audioClient.vtable.GetMixFormat(audioClient, cast<WAVEFORMATEX**>&wave_format)
        CHECK_HR
        WASLOG("pass audioClient.GetMixFormat")
        // log("WAVE format:")
        // std_print(wave_format, pretty = true)

        res = audioClient.vtable.Initialize(audioClient, AUDCLNT_SHAREMODE_SHARED, 0, buffer_duration_100ns, 0,  cast<WAVEFORMATEX*>wave_format, null)
        CHECK_HR
        WASLOG("pass audioClient.Initialize")

        res = audioClient.vtable.GetService(audioClient, &IAudioRenderClient_GUID, &renderService)
        CHECK_HR
        WASLOG("pass audioClient.GetService")

        audioClient.vtable.Start(audioClient)
        CHECK_HR
        WASLOG("pass audioClient.Start")

        // TODO: Extinsible format may have multiple channels, more than SPEAKER_FRONT_LEFT and SPEAKER_FRONT_RIGHT.
        //   Those are the only channels we support so we should zero the other ones (if using float, if using 16-bit then set to 2^15).

        // TODO: Handle 16-bit and 32-bit integer?
        Assert(equal(cast<char*>&wave_format.SubFormat, cast<char*>&KSDATAFORMAT_SUBTYPE_IEEE_FLOAT, 16))
        Assert(wave_format.Format.nChannels == 2)
        Assert(wave_format.Format.wBitsPerSample == 32)
        // Assert(equal(cast<char*>&expected_format.SubFormat, cast<char*>&KSDATAFORMAT_SUBTYPE_PCM, 16))
    }

    fn switchAudioDevice(id: u64) {
        mutex.lock()
        backend_id: StringBuilder
        for internalAudioDevices {
            if it.id == id {
                backend_id.append(it.backend_id)
                break
            }
        }
        mutex.unlock()

        if !backend_id.len {
            // could not find id.
            log("Audio: Could not find audio device ID: ", id)
            sound_state.selected_output_device_id = sound_state.current_output_device_id
            return
        }

        res: HRESULT
        collection: IMMDeviceCollection*
        res = enumerator.vtable.EnumAudioEndpoints(enumerator, eRender, DEVICE_STATE_ACTIVE, &collection)
        CHECK_HR

        count: u32
        res = collection.vtable.GetCount(collection, &count)
        CHECK_HR

        endpoint: IMMDevice*
        for 0..count {
            props: IPropertyStore*
            res = collection.vtable.Item(collection, nr, &endpoint)
            CHECK_HR
            // log("pass Item ",nr)

            res = endpoint.vtable.OpenPropertyStore(endpoint, STGM_READ, &props)
            CHECK_HR
            // log("pass OpenPropertyStore")

            device_id: u16*
            res = endpoint.vtable.GetId(endpoint, &device_id)
            CHECK_HR
        
            device_id_str: StringBuilder
            ParseWideCharString(device_id, &device_id_str)
            // log("Try switch device ",backend_id, " = ", device_id_str)

            if backend_id == device_id_str {
                // we found the one
                props.vtable.Release(props)
                break
            }


            props.vtable.Release(props)
            endpoint.vtable.Release(endpoint)

            endpoint = null
        }

        collection.vtable.Release(collection)

        if endpoint {
            // Release current device
            renderService.vtable.Release(renderService)
            audioClient.vtable.Release(audioClient)
            device.vtable.Release(device)

            // setup new device
            device = endpoint
            init_device()
            sound_state.current_output_device_id = id
        } else {
            // keep using previous device
        }
    }
    
    fn cleanup() {
        res: i32

        audioClient.vtable.Stop(audioClient)
        CHECK_HR
        WASLOG("pass audioClient.Stop")

        renderService.vtable.Release(renderService)
        audioClient.vtable.Release(audioClient)
        device.vtable.Release(device)
        enumerator.vtable.Release(enumerator)
        CoUninitialize()
    }
    // frames that have not been consumed
    fn remainingFrames() -> i32 {
        res: i32
        Assert(audioClient)
        frames: i32
        res = audioClient.vtable.GetCurrentPadding(audioClient, cast<u32*>&frames)
        CHECK_HR
        // log("pass audioClient.GetCurrentPadding")
        return frames
    }
    fn acquireBuffer(frames: i32) -> u8* {
        res: i32
        Assert(renderService)
        renderBuffer: u8*
        res = renderService.vtable.GetBuffer(renderService, frames, &renderBuffer)
        CHECK_HR
        // log("pass renderService.GetBuffer")

        return renderBuffer
    }
    fn releaseBuffer(written_frames: i32) {
        res: i32
        Assert(renderService)
        res = renderService.vtable.ReleaseBuffer(renderService, written_frames, 0)
        CHECK_HR
        // log("pass renderService.ReleaseBuffer")
    }
    
    fn listAudioDevices(list: Array<AudioDeviceInfo>*, exclude_input_devices: bool = false, exclude_output_devices: bool = false) {
        Assert(sound_state)

        res: HRESULT

        collection: IMMDeviceCollection*

        res = enumerator.vtable.EnumAudioEndpoints(enumerator, eRender, DEVICE_STATE_ACTIVE, &collection)
        CHECK_HR

        count: u32
        res = collection.vtable.GetCount(collection, &count)
        CHECK_HR

        default_device: IMMDevice*
        res = enumerator.vtable.GetDefaultAudioEndpoint(enumerator, eRender, eConsole, &default_device)

        default_id: u16*
        if res == 0 {
            res = default_device.vtable.GetId(default_device, &default_id)
            CHECK_HR
        } else if res != cast<i32>E_NOTFOUND {
            CHECK_HR
        }

        for 0..count {
            endpoint: IMMDevice*
            props: IPropertyStore*
            res = collection.vtable.Item(collection, nr, &endpoint)
            CHECK_HR
            // log("pass Item ",nr)

            res = endpoint.vtable.OpenPropertyStore(endpoint, STGM_READ, &props)
            CHECK_HR
            // log("pass OpenPropertyStore")


            ch: char[50] // extra buffer in case PROPVARIANT is defined to small
            prop_name: PROPVARIANT
            

            res = props.vtable.GetValue(props, &DEVPKEY_Device_FriendlyName, &prop_name)
            CHECK_HR
            // log("pass GetValue")

            info := list.add()
            
            ParseWideCharString(cast<u16*>cast<void*>prop_name.union_data, &info.name)


            device_id: u16*
            res = endpoint.vtable.GetId(endpoint, &device_id)
            CHECK_HR
        
            fn equal(a: u16*, b: u16*) -> bool {
                if !a || !b
                    return false
                while *a == *b {
                    if *a == 0 {
                        return true
                    }
                    a+=2
                    b+=2
                }
                return false
            }
            info.is_default = equal(device_id, default_id)

            device_id_str: StringBuilder
            ParseWideCharString(device_id, &device_id_str)
            // log(device_id_str)

            found := false
            for sound_state.audio_backend.internalAudioDevices {
                if it.backend_id == device_id_str {
                    found = true
                    info.id = it.id
                }
            }
            if !found {
                internal_info := sound_state.audio_backend.internalAudioDevices.add()
                internal_info.backend_id.append(device_id_str)
                internal_info.id = sound_state.audio_backend.next_device_id()
                info.id = internal_info.id
            }

            // log("Device ",nr, " : ", name)

            props.vtable.Release(props)
            endpoint.vtable.Release(endpoint)
        }

        collection.vtable.Release(collection)
        default_device.vtable.Release(default_device)
    }
}

// @param path Only WAV audio files are supported (the file does not need .wav extension, format is determined with RIFF and WAVE magic numbers). The SoundRef will be named path.
// @param offset_into_file Useful when reading packed custom game asset files.
// @param stream_file Read chunks from the file as the audio is needed. Recommended for music
//    with a long duration but, stream is not necessary for short sounds with small memory footprint.
//    IMPORTANT: File needs to be readable as long as the SoundRef exists. Otherwise you may play
//      a sound but when new chunks are needed reading from the file fails and then NO AUDIO!
fn LoadSoundFromFile(path: char[], offset_into_file: i64 = 0, stream_file: bool = false) -> SoundRef, SoundError  {
    Assert(sound_state)

    res: i32

    if stream_file {
        Assert(false);
        // TODO: Check valid WAV format
        // TODO: If streaming file then don't read whole file. In fact. don't read it at all.
    } else {
        filesize: i64
        file := FileOpen(path, FILE_READ_ONLY, &filesize)
        if !file {
            return { SOUND_INVALID_HANDLE }, SOUND_FILE_NOT_FOUND
        }
        defer FileClose(file)

        if filesize - offset_into_file < WAVFILE_HEADER_SIZE {
            // file too small
            return { SOUND_INVALID_HANDLE }, SOUND_CORRUPTED_FILE
        }

        res = FileSetHead(file, offset_into_file, FILE_SET_BEG)
        Assert(res == offset_into_file) // TODO: Don't assert

        // NOTE: This is a little complicated since we don't want to read the whole file at once in case
        //   is a huge game asset pack. We first check and read the WAV header and then check and read the data.
        temp_max := 64
        temp := Allocate(temp_max)
        Assert(temp)


        res = FileRead(file, temp, WAVFILE_HEADER_SIZE)
        Assert(res == WAVFILE_HEADER_SIZE)

        wav, err := ParseWAVHeader({temp, WAVFILE_HEADER_SIZE}, path = path, print = true)
        if !wav {
            Free(temp, temp_max)
            return { SOUND_INVALID_HANDLE }, SOUND_CORRUPTED_FILE
        }

        new_temp := Reallocate(wav.size_of_chunks, temp, temp_max)
        Assert(new_temp)

        res = FileRead(file, new_temp, wav.size_of_chunks)
        Assert(res == wav.size_of_chunks)

        ParseWAVChunks({new_temp, wav.size_of_chunks}, wav, use_passed_data_memory = true, path = path, print = true)

        sound := sound_state.createSoundRef(path) // path is name of sound ref
        sound.wav = wav
        sound.total_frames = wav.data_len / cast<i32>wav.block_align
        
        ref: SoundRef
        ref.handle = sound.handle
        return ref, SOUND_SUCCESS
    }
    return { SOUND_INVALID_HANDLE }, SOUND_UNSUPPORTED_FILE_FORMAT
}
fn CreateSoundStream(name: char[], buffer_size: i32, format: AudioFormat*) {
    Assert(sound_state)

    // size must be a multiple of frame size. We can't have 57.23 samples in the buffer, it must be a whole number.
    Assert(buffer_size % format.frame_size() == 0)

    sound := sound_state.createSoundRef()

    sound.format = *format
    sound.buffer.ptr = Allocate(buffer_size)
    sound.buffer.len = buffer_size
    Assert(sound.buffer.ptr)

    ref: SoundRef
    ref.handle = sound.handle
    return ref, SOUND_SUCCESS
}
// @param name SoundRef will get this name.
// @param file_data Raw file data to parse (only .wav files are supported). Useful if you store assets in one large packed file. With LoadSoundFromFile you are limited to the OS file system.
// @param stream_file TODO: Not sure if this should exist? It requires the file_data memory to continously exist.
fn LoadSoundFromRawFileData(name: char[], file_data: u8[], stream_file: bool = false) -> SoundRef, SoundError  {
    Assert(sound_state)

    if stream_file {
        // TODO: Check valid WAV format
        // TODO: Implement streaming
        Assert(false);
    } else {
        // TODO: Look at LoadSoundFromFile
        Assert(false);
    }
    
    return { SOUND_INVALID_HANDLE }, SOUND_UNSUPPORTED_FILE_FORMAT
}

/*######################
        WAV File
#######################*/

enum WAVError {
    WAV_SUCCESS,
    WAV_CORRUPT,
    WAV_FILE_NOT_FOUND,
}

#macro WAVFILE_HEADER_SIZE 36

#macro WAVFILE_AUDIO_FORMAT_PCM_INTEGER 1
#macro WAVFILE_AUDIO_FORMAT_IEEE_FLOAT 3

struct WAVFile {
    // IMPORTANT: IF YOU CHANGE STUFF HERE YOU NEED TO CHANGE STUFF IN EXAMPLES. One of them is: sample_wasapi.btb 
    audio_format: u16;
    channels: u16;
    sample_rate: u32;
    byte_rate: u32;
    block_align: u16; // bits_per_sample * channels
    bits_per_sample: u16;

    size_of_chunks: i32; // size of the remaining chunks (size of whole file except for header)

    owner_of_data_allocation: bool; // if true then you need to free data
    data: u8*;
    data_len: i32;
}

// TODO: Argument to pass in allocator
// @param path only used when printing error
fn ParseWAVHeader(data: u8[], print: bool = false, path: char[] = "unknown") -> WAVFile*, WAVError {
    head := 0
    char_ptr := cast<char*>data.ptr

    if data.len < WAVFILE_HEADER_SIZE {
        if print
            log("ParseWAVHeader: Size of data is too small for WAV header (was ",data.len, " needs to be at least ",WAVFILE_HEADER_SIZE,"), origin path = ",path)
        return null, WAV_CORRUPT
    }
    
    if !equal(char_ptr + head, "RIFF".ptr, 4) {
        if print
            log("ParseWAVHeader: 'RIFF' magic incorrect (was ",Slice<char>{char_ptr+head,4},"), origin path = ",path)
        return null, WAV_CORRUPT
    }
    head += 4

    almost_file_size := *cast<i32*>(data.ptr + head)
    head += 4

    // if data.len < almost_file_size + 8 {
    //     if print
    //         log("ParseWAVHeader: File size in header was ",almost_file_size," bytes which does not match size of passed in data of ",data.len,"-8 (-8 because RIFF and file size field are excluded), origin path = ",path)
    //     return null, WAV_CORRUPT
    // }

    if !equal(char_ptr + head, "WAVE".ptr, 4) {
        if print
            log("ParseWAVHeader: 'WAVE' marker incorrect (was ",Slice<char>{char_ptr+head,4},"), origin path = ",path)
        return null, WAV_CORRUPT
    }
    head += 4

    // TODO: Can WAV files have multiple format and data chunks? If so handle it.

    if !equal(char_ptr + head, "fmt ".ptr, 4) {
        if print
            log("ParseWAVHeader: 'fmt ' marker incorrect (was ",Slice<char>{char_ptr+head,4},"), origin path = ",path)
        return null, WAV_CORRUPT
    }
    head += 4

    format_size := *cast<i32*>(data.ptr + head)
    head += 4

    if format_size != 16 { // always 16 for WAVE (i think)
        if print
            log("ParseWAVHeader: Size of format was ",format_size," bytes but should be 16 (probably?), origin path = ",path)
        return null, WAV_CORRUPT
    }

    success := false
    wav: WAVFile* = Allocate(sizeof(WAVFile))
    construct(wav)
    defer if !success DestroyWAVFile(wav)
    
    wav.size_of_chunks = almost_file_size - WAVFILE_HEADER_SIZE + 8

    wav.audio_format    = *cast<u16*>(data.ptr + head)
    wav.channels        = *cast<u16*>(data.ptr + head + 2)
    wav.sample_rate     = *cast<u32*>(data.ptr + head + 4)
    wav.byte_rate       = *cast<u32*>(data.ptr + head + 8)
    wav.block_align     = *cast<u16*>(data.ptr + head + 12)
    wav.bits_per_sample = *cast<u16*>(data.ptr + head + 14)
    head += 16

    Assert(head == WAVFILE_HEADER_SIZE)

    success = true // so we don't defer and destroy WAV file
    return wav, WAV_SUCCESS
}
// If error is returned don't forget to destroy WAVFile returned by ParseWAVHeader
// @param data slice should directly point at data section in WAV file (WAVFILE_HEADER_SIZE from start)
fn ParseWAVChunks(data: u8[], wav: WAVFile*, use_passed_data_memory: bool = false, print: bool = false, path: char[] = "unknown") -> WAVError {
    head: u32 = 0
    char_ptr := cast<char*>data.ptr
    while head < cast<u32>data.len {
        chunk_id := char_ptr + head
        head += 4
        chunk_len := *cast<u32*>(data.ptr + head)
        head += 4

        // log(Slice<char>{chunk_id,4}, " ", chunk_len)

        if equal(chunk_id, "data".ptr, 4) {
            if cast<u32>data.len - head < chunk_len {
                if print
                    log("ParseWAVChunks: Data chunk size was ",chunk_len," bytes which is to large, expected no less than ",data.len-head," bytes which is the remaining size of the file data, origin path = ",path)
                return WAV_CORRUPT
            }

            wav.data_len = chunk_len

            if(cast<u32>wav.data_len % wav.block_align != 0) {
                if print
                    log("ParseWAVChunks: Size of data should be divisible by block_align (",wav.data_len," % ",wav.block_align,"=",(cast<u32>wav.data_len%wav.block_align),"), origin path = ",path)
                return WAV_CORRUPT
            }

            if use_passed_data_memory {
                wav.data = data.ptr + head
            } else {
                wav.data = Allocate(chunk_len)
                Assert(wav.data)
                memcpy(wav.data, data.ptr + head, chunk_len)
                wav.owner_of_data_allocation = true
            }

            head += chunk_len
        } else {
            // skip unknown chunk
            head += chunk_len
        }
    }

    if !wav.data {
        if print
            log("ParseWAVChunks: 'data' chunk does not exist, origin path = ",path)
        return WAV_CORRUPT
    }

    return WAV_SUCCESS
}

fn DestroyWAVFile(wav: WAVFile*) {
    if wav.data
        Free(wav.data, wav.data_len)
    Free(wav, sizeof(WAVFile))
}

// IMPORTANT: DO NOT MODIFY THE SIGNATURE OR NAME OF THIS FUNCTION. It is used by examples (sample_wasapi.btb).
//   You can change the internals as long as the function returns WAVFile with WAV data.
fn ReadWAVFile(path: char[], print: bool = false) -> WAVFile*, WAVError {
    data, yes := ReadWholeFile(path)
    if !yes {
        if print
            log("ReadWAVFile: Could not read ", path)
        return null, WAV_FILE_NOT_FOUND
    }
    wav, err := ParseWAVHeader(Slice<u8>{cast<u8*>data.ptr, data.len}, print, path)
    if wav {
        err = ParseWAVData(Slice<u8>{cast<u8*>data.ptr + WAVFILE_HEADER_SIZE, data.len - WAVFILE_HEADER_SIZE}, wav, print, path)
        if err != WAV_SUCCESS {
            DestroyWAVFile(wav)
        }
    }
    return wav, err
}


/*###############################
     Implementation and design
#################################

The Sound module has two parts (not clearly seperated). The audio backend, which uses WASAPI for Windows and ALSA for Linux, and the audio system which provides a platform independent API for developers to play sounds, capture audio, stream music from a file, start and pause sounds, and play 3D sounds.

Behind the scenes the audio system talks to the backend and provides it with audio data, enumerates devices, retrives microphone audio, reads audio from sound files in various WAVE formats, mixes multiple sounds based on volume, pitch, 3D location (if enabled for the particular sound), processes intense mixing in a seperate thread if you enable it or if you want to call the process sound function yourself.


#########################
        Questions?
#########################


# WHY SoundRef AND SoundInstance

We have SoundRef and SoundInstance because you may want to load a item collect sound
and play it simultaneously. If we just had SoundRef you would load the sound and call play
but what happens if you call play again? Do we stop the current sound that is playing, well no.
Sure we could internal create a new instance of the sound but from a developers view it's just SoundRef.
Problem is that the sound may be a NPC voice which you want to pause when player presses escape.
To pause the sound we need to know which sound we're pausing and we may not want to pause all sounds.

Ultimately we have SoundRef.play_once() for coin collect sounds and SoundRef.create_instance() with more
control for NPC voice sound.

# WHY SoundRef and SoundRef_impl

This is not about hiding implementation details (if I cared about that structs would have private and public fields).
The reasoning behind this is SoundRef not being a pointer meaning that you can call cleanup on it and the data in SoundRef
will be reset. Next time you call a method on it will Assert or do nothing.

With a pointer where allocate and free it you may call cleanup and forget to throwaway the pointer. By having SoundRef as non-pointer that refers to some allocated memory for SoundRef_impl we have more control and options and less error prone.

# WHY ONLY WAV?

Audio files are complex and hard to implement and the documentation on them is somewhat lacking. Therefore you need to use a library for them. But also, I doubt we would be able to implement a better ogg or mp3 decoder than what popular libraries do 
so you probably want to use a library anyway.

# WHY IS 0 as SoundRef.handle INVALID?

Over the years I have made systems use 0 as handle which is problematic since it is a valid index.
Either you have an array where the first element is unused or when accessing the array you do 'handle-1' and
when creating handles 'handle+1'. This is awful to keep track of so unused first element is best. I have also used -1
to indicate invalid handle which is problematic because you can't reset structs, elements and arrays which contain handles
to zero since that means a valid handle.

A minor or major issue with the language is x: u64 = -1 becomes 4294967295 not -1 which isn't great. It happens because literal integers are i32 by default.
The type of literals are not inferred which they should be.

This time I have chosen 0 as invalid handle and first element being unused if handle is an index into an array. (we may use a hashmap instead)

*/