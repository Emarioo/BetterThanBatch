fn ChangeOutputAudioDevice(id: u64) -> bool {
    Assert(sound_state)

    // "queue" the output device change action, handled when we process sound (potentially on another thread)
    sound_state.selected_output_device_id = id;
    return false
}

// @param format Format of internal buffer and the amount of samples it can hold. This how often you have to consume the buffer before it is filled up. Sample rate of 48 0000, 32-bit float, and stereo is recommended.
// @param frame_count Number of frames (each frame has a number of samples equal to the number of channels)
fn InitInputAudioBuffer(format: AudioFormat*, buffer_size: i32) {
    Assert(sound_state)

    Assert(buffer_size % format.frame_size() == 0)

}

// @return Bytes in internal input buffer. If bytes is equal to max audio buffer size then it is likely you lost samples because you weren't consuming the buffer fast enough.
fn BytesInInputAudioBuffer() -> i32 {
    Assert(sound_state)


}

// @param user_buffer Audio data is moved from internal buffer to user buffer. user_buffer.len specified the max bytes to consume.
// @returns Consumed bytes.
fn ConsumeInputAudioBuffer(user_buffer: u8*, max_size: i32) -> i32 {
    Assert(sound_state)


}

enum AudioSampleFormat {
    AUDIO_8BIT_PCM,
    AUDIO_16BIT_PCM,
    AUDIO_32BIT_PCM,
    AUDIO_32BIT_FLOAT,
}
struct AudioFormat {
    sample_rate: i32; // 48 0000 Hz
    stereo: bool; // false - Mono, true - Stereo
    sample_format: AudioSampleFormat; // AUDIO_32BIT_FLOAT

    fn frames_from_duration(time: f32) -> i32 {
        return sample_rate * time
    }
    fn byte_size_from_duration(time: f32) -> i32 {
        // buffer size must be a multiple of frame size, we must cast float before multiplying frame size
        return frame_size() * cast<i32>(sample_rate * time)
    }
    fn frame_size() -> i32 {
        size := 0
        switch sample_format {
            case AUDIO_8BIT_PCM:
                size = 1
            case AUDIO_16BIT_PCM:
                size = 2
            case AUDIO_32BIT_PCM:
            case AUDIO_32BIT_FLOAT:
                size = 4
        }
        if stereo
            size *= 2
        return size
    }
}

/*###############################
    IMPLEMENTATION SPECIFIC
###############################*/

struct SoundRef_impl {
    handle: u64; // handle is 64-bit in case we ever want it to represent a pointer
    name: StringBuilder; // path to audio file or user defined name when using LoadSoundFromRawFileData
    bucket_index: i32;

    // TODO: Add stream data and fields for it
    wav: WAVFile*;
    total_frames: i32;

    // stream buffer and format when streaming
    format: AudioFormat;
    buffer: u8[]; // circular buffer
    buffer_head: i32;
    buffer_tail: i32;
}
struct SoundInstance_impl {
    handle: u64;
    sound_ref_handle: u64;
    bucket_index: i32;

    playing: bool;
    current_frame: i32; // number of frames written to audio device buffer (not that the sample may not have been played by audio backend yet)

    // TODO: pos: vec3;
}

// Manager of all resources such as:
//   references, streams, instances, memory, file handles, and threads.
struct SoundState {
    refs: BucketArray<SoundRef_impl>;
    instances: BucketArray<SoundInstance_impl>;
    m_next_handle: u64;
    audio_backend: AudioBackend;

    last_time: i64;
    global_volume: f32 = 1.0;

    selected_output_device_id: u64;
    current_output_device_id: u64;

    fn init() {
        refs.init(64)
        instances.init(64)
        m_next_handle = 1
    } 
    fn cleanup() {
        refs.cleanup()
        instances.cleanup()
        audio_backend.cleanup()
    }

    // @return Always returns a valid pointer (asserts if something fails)
    fn createSoundRef(name: char[]) -> SoundRef_impl* {
        impl, index := refs.add(null)
        Assert(impl)
        impl.bucket_index = index
        impl.handle = nextHandle()
        impl.name.append(name)
        return impl
    }

    fn getSoundRef(handle: u64) -> SoundRef_impl* {
        for refs {
            if it.handle == handle
                return it
        }
        return null
    }

    // 0.0 - maxfloat?
    fn setGlobalVolume(volume: f32) {
        global_volume = volume
    }

    // @return Always returns a valid pointer (asserts if something fails)
    fn createSoundInstance(ref: SoundRef) -> SoundInstance_impl* {
        impl, index := instances.add(null)
        Assert(impl)
        impl.bucket_index = index
        impl.handle = nextHandle()
        impl.sound_ref_handle = ref.handle
        return impl
    }

    fn getSoundInstance(handle: u64) -> SoundInstance_impl* {
        for instances {
            if it.handle == handle
                return it
        }
        return null
    }

    fn nextHandle() -> u64 {
        return m_next_handle++
    }
}
struct AudioDeviceInfo {
    id: u64;
    name: StringBuilder;
    is_default: bool;
    is_input_device: bool; // input means microphone
}
global sound_state: SoundState*

// TODO: Flags on whether to create a thread or if user should call a function to do sound processing.
fn InitSoundState() {
    Assert(!sound_state)

    sound_state = Allocate(sizeof(SoundState))
    construct(sound_state)

    // TODO: We should not initialize default device by default.
    //   An application may have a settings, config or cache file where the audio device used last time
    //   the application was running is stored. If so they want to use that device instead of the default.
    sound_state.audio_backend.init_default_device()
}

fn DestroySoundState() {
    Assert(sound_state)

    sound_state.cleanup()
    Free(sound_state, sizeof(SoundState))
    sound_state = null
}
global sound_cycles: i64
global sound_cycles_max: i64
global sound_frames: i64



fn ProcessSound() {
    Assert(sound_state)

    if sound_state.selected_output_device_id != sound_state.current_output_device_id {
        // next_device_id
        sound_state.audio_backend.switchAudioDevice(sound_state.selected_output_device_id)
    }

    start_time := StartMeasure()


    // Check the state of the buffer. Do we need to fill it up.

    /* Concerns:
        If we have 5 sounds with 1-5 second durations then we can't fill up the buffer with all those sounds
        because we might want to add new sounds the next frame. So we'll process the sound for this frame.
    */

    if sound_state.last_time == 0 {
        // first time processing sound
        sound_state.last_time = StartMeasure()
    }
    now := StartMeasure()
    delta := DiffMeasure(now - sound_state.last_time)
    sound_state.last_time = now


    remaining_frames := sound_state.audio_backend.remainingFrames()

    // Generally speaking, through experiments. process_rate should be double the frequency at which we call ProcessSound.
    // Holding two game frames worth of audio keeps us safe.
    // process_rate: f64 = 0.020 // 20 ms (We expect to run ProcessSound at 60 Hz, 60 times per second, this would be 16.66 ms but we give it some leeway)
    process_rate: f64 = 4 * 0.016 // 20 ms (We expect to run ProcessSound at 60 Hz, 60 times per second, this would be 16.66 ms but we give it some leeway)

    wanted_frames_in_buffer: i32 = process_rate * sound_state.audio_backend.wave_format.Format.nSamplesPerSec

    frames_to_write := wanted_frames_in_buffer - remaining_frames

    if(remaining_frames == 0) {
        // Show delta information and so on...
        // log("Sound process engine can't keep up!")
    }
    // log("delta ", delta, " ", frames_to_write)
    // log("delta", delta, " ", remaining_frames,"/",wanted_frames_in_buffer)
    // log("delta", delta, " ", remaining_frames,"/",wanted_frames_in_buffer)

    if frames_to_write == 0 {
        // log("(nothing to write), delta ", delta)
    }

    // TODO: Measure audio processing time.

    // TODO: If no audio is playing then don't acquire buffer.

    // NOTE: We expect the audio stream to be 32-bit float. We will handle others in the future.
    buffer: f32* = cast<f32*>sound_state.audio_backend.acquireBuffer(frames_to_write)
    buffer_len := frames_to_write * 2 * 4 // channels * 32-bit float PCM
    memzero(buffer,buffer_len)
    
    // TODO: Read about GetBuffer and ReleaseBuffer and Initialize AudioClient for a correct implementation where
    //   Errors are handled. For example we write to slowly to the buffer.

    // TODO: Parse WAV sound data

    // log("####### DELTA ", delta)
    // log("Remaining frames ", remaining_frames, " (",wanted_frames_in_buffer,")")
    // log("volume ", sound_state.global_volume)
    // log("frames_to_write ", frames_to_write)

    // TODO: Check thread safety
    for instance: sound_state.instances {
        sound := sound_state.getSoundRef(instance.sound_ref_handle)

        if !instance.playing
            continue

        wav := sound.wav

        // TODO: 24-bit support?

        Assert(wav.channels == 1 || wav.channels == 2)
        Assert(wav.bits_per_sample == 8 || wav.bits_per_sample == 16 || wav.bits_per_sample == 32)
        Assert(wav.audio_format == WAVFILE_AUDIO_FORMAT_PCM_INTEGER || wav.audio_format == WAVFILE_AUDIO_FORMAT_IEEE_FLOAT)

        bits_per_sample: i32 = wav.bits_per_sample
        channels: i32 = wav.channels
        audio_format: i32 = wav.audio_format

        src_32f := cast<f32*>wav.data + instance.current_frame * cast<i32>wav.channels * sizeof(f32)
        src_32  := cast<i32*>wav.data + instance.current_frame * cast<i32>wav.channels * sizeof(i32)
        src_16  := cast<i16*>wav.data + instance.current_frame * cast<i32>wav.channels * sizeof(i16)
        src_8   := cast<u8*>wav.data + instance.current_frame * cast<i32>wav.channels

        // TODO: SIMD, write in assembly?

        // log(bits_per_sample, " ",channels, " ", wav.sample_rate)

        sample_ratio: f32 = cast<f32>cast<i32>wav.sample_rate / cast<f32>cast<i32>sound_state.audio_backend.wave_format.Format.nSamplesPerSec

        src_sample_index0: i32
        for 0..frames_to_write {
            src_sample_index: f32 = nr * sample_ratio
            src_sample_index0 = src_sample_index

            fraction: f32 = src_sample_index - src_sample_index0

            // log("d ", src_sample_index0, " ", fraction)

            if src_sample_index0 + 1 >= sound.total_frames - instance.current_frame {
                instance.playing = false
                break
            }

            out_sample0: f32
            out_sample1: f32
            if bits_per_sample == 8 && channels == 1 {
                out_sample0 = ((cast<i32>src_8[src_sample_index0] - 128) / 128.0) * (1.0 - fraction) + ((cast<i32>src_8[src_sample_index0 + 1] - 128) / 128.0) * fraction
                out_sample1 = out_sample0

            } else if bits_per_sample == 8 && channels == 2 {
                out_sample0 := ((cast<i32>src_8[2*src_sample_index0    ] - 128) / 128.0) * (1.0 - fraction) + ((cast<i32>src_8[2*(src_sample_index0 + 1)    ] - 128) / 128.0) * fraction
                out_sample1 := ((cast<i32>src_8[2*src_sample_index0 + 1] - 128) / 128.0) * (1.0 - fraction) + ((cast<i32>src_8[2*(src_sample_index0 + 1) + 1] - 128) / 128.0) * fraction
            
            } else if bits_per_sample == 16 && channels == 1 {
                out_sample0 = ((cast<i32>src_16[src_sample_index0]) / 32768.0) * (1.0 - fraction) + ((cast<i32>src_16[src_sample_index0 + 1]) / 32768.0) * fraction
                out_sample1 = out_sample0
            
            } else if bits_per_sample == 16 && channels == 2 {
                out_sample0 = ((cast<i32>src_16[2*src_sample_index0    ]) / 32768.0) * (1.0 - fraction) + ((cast<i32>src_16[2*(src_sample_index0 + 1)    ]) / 32768.0) * fraction
                out_sample1 = ((cast<i32>src_16[2*src_sample_index0 + 1]) / 32768.0) * (1.0 - fraction) + ((cast<i32>src_16[2*(src_sample_index0 + 1) + 1]) / 32768.0) * fraction
           
            } else if bits_per_sample == 32 && channels == 1 && audio_format == WAVFILE_AUDIO_FORMAT_PCM_INTEGER {
                out_sample0 = ((cast<i32>src_32[src_sample_index0]) / 2147483648.0) * (1.0 - fraction) + ((cast<i32>src_32[src_sample_index0 + 1]) / 2147483648.0) * fraction
                out_sample1 = out_sample0
            
            } else if bits_per_sample == 32 && channels == 2 && audio_format == WAVFILE_AUDIO_FORMAT_PCM_INTEGER {
                out_sample0 = ((cast<i32>src_32[2*src_sample_index0    ]) / 2147483648.0) * (1.0 - fraction) + ((cast<i32>src_32[2*(src_sample_index0 + 1)    ]) / 2147483648.0) * fraction
                out_sample1 = ((cast<i32>src_32[2*src_sample_index0 + 1]) / 2147483648.0) * (1.0 - fraction) + ((cast<i32>src_32[2*(src_sample_index0 + 1) + 1]) / 2147483648.0) * fraction
            
            } else if bits_per_sample == 32 && channels == 1 && audio_format == WAVFILE_AUDIO_FORMAT_IEEE_FLOAT {
                out_sample0 = src_32f[src_sample_index0] * (1.0 - fraction) + src_32f[src_sample_index0 + 1] * fraction
                out_sample1 = out_sample0
            
            } else if bits_per_sample == 32 && channels == 2 && audio_format == WAVFILE_AUDIO_FORMAT_IEEE_FLOAT {
                out_sample0 = src_32f[2*src_sample_index0    ] * (1.0 - fraction) + src_32f[2*(src_sample_index0 + 1)    ] * fraction
                out_sample1 = src_32f[2*src_sample_index0 + 1] * (1.0 - fraction) + src_32f[2*(src_sample_index0 + 1) + 1] * fraction
            }

            buffer[2*nr    ] += out_sample0 * sound_state.global_volume
            buffer[2*nr + 1] += out_sample1 * sound_state.global_volume
        }
        // log("fin frame ", instance.current_frame, "/",sound.total_frames)
        instance.current_frame += src_sample_index0+1
    }

    sound_state.audio_backend.releaseBuffer(frames_to_write)

    end_time := StartMeasure()
    sound_cycles+=end_time - start_time
    sound_frames+=1
    if end_time - start_time > sound_cycles_max && sound_frames > 5 // throw away first few
        sound_cycles_max = end_time - start_time
    tim := DiffMeasure(end_time - start_time)
    // log("Frame time ", tim*1000, " ms")
}
struct InternalAudioDevice {
    id: u64;
    backend_id: StringBuilder; // uuid on windows
}
struct AudioBackend {
    enumerator: IMMDeviceEnumerator*;
    device: IMMDevice*;
    audioClient: IAudioClient*;
    wave_format: WAVEFORMATEXTENSIBLE*;
    renderService: IAudioRenderClient*;

    mutex: Mutex;
    internalAudioDevices: Array<InternalAudioDevice>;
    m_next_device_id: u64 = 1;

    buffer_duration_100ns: i32 = 80_000_00; // 80 ms

    fn next_device_id() -> u64 {
        return m_next_device_id++
    }

    fn init_default_device() {
