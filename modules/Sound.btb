        //     res = props.vtable.GetValue(props, &DEVPKEY_Device_FriendlyName, &prop_name)
        //     CHECK_HR
        //     // log("pass GetValue")

        //     name: StringBuilder;
        //     ParseWideCharString(cast<u16*>cast<void*>prop_name.union_data, &name)

        //     log("Device ",nr, " : ", name)

        //     props.vtable.Release(props)
        //     endpoint.vtable.Release(endpoint)
        // }

