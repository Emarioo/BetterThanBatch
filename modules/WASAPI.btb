#macro IMMNotificationClient void


struct IMMDeviceEnumerator_vtable {
    QueryInterface: fn @stdcall (
            This: IMMDeviceEnumerator*,
            riid: GUID*,
            ppvObject: void**) -> HRESULT;
    AddRef: fn @stdcall (This: IMMDeviceEnumerator*) -> u32;
    Release: fn @stdcall (This: IMMDeviceEnumerator*) -> u32;
    EnumAudioEndpoints: fn @stdcall (This: IMMDeviceEnumerator*, dataflow: EDataFlow, dwStateMask: u32, ppDevices: IMMDeviceCollection**) -> HRESULT;
    GetDefaultAudioEndpoint: fn @stdcall (This: IMMDeviceEnumerator*, dataflow: EDataFlow, role: ERole, ppEndPoint: IMMDevice**) -> HRESULT;
    GetDevice: fn @stdcall (This: IMMDeviceEnumerator*, pwstrId: u16*, ppDevice: IMMDevice**) -> HRESULT;
    RegisterEndpointNotificationCallback: fn @stdcall (This: IMMDeviceEnumerator*, pClient: IMMNotificationClient*) -> HRESULT;
    UnregisterEndpointNotificationCallback: fn @stdcall (This: IMMDeviceEnumerator*, pClient: IMMNotificationClient*) -> HRESULT;
}
struct IMMDeviceEnumerator {
    vtable: IMMDeviceEnumerator_vtable*;
}
enum VARTYPE : u16 {
    VT_LPSTR	= 30,
    VT_LPWSTR	= 31,
}

struct PROPVARIANT {
    vt: VARTYPE;
    wReserved1: u16;
    wReserved2: u16;
    wReserved3: u16;
    union_data: u64; // BTB don't have unions right now
}

struct IPropertyStore_vtable {
    QueryInterface: fn @stdcall (This: IPropertyStore*, riid: GUID*, ppvObject: void**) -> HRESULT;
    AddRef: fn @stdcall (This: IPropertyStore*) -> u32;
    Release: fn @stdcall (This: IPropertyStore*) -> u32;

    GetCount: fn @stdcall (This: IPropertyStore*, cProps: u32*) -> HRESULT;
    GetAt: fn @stdcall (This: IPropertyStore*, iProp: u32, pkey: PROPERTYKEY*) -> HRESULT;
    GetValue: fn @stdcall (This: IPropertyStore*, key: PROPERTYKEY*, pv: PROPVARIANT*) -> HRESULT;
    SetValue: fn @stdcall (This: IPropertyStore*, key: PROPERTYKEY*, propvar: PROPVARIANT*) -> HRESULT;
    Commit: fn @stdcall (This: IPropertyStore*) -> HRESULT;
}

struct IPropertyStore {
    vtable: IPropertyStore_vtable*;
}
fn ParseWideCharString(wstr: u16*, out: StringBuilder*) {
    while *wstr {
        out.append(cast<char>*wstr)
        wstr += 2
    }
}

struct IMMDeviceCollection_vtable {
    QueryInterface: fn @stdcall (This: IMMDeviceCollection*, riid: GUID*, ppvObject: void**) -> HRESULT;
    AddRef: fn @stdcall (This: IMMDeviceCollection*) -> u32;
    Release: fn @stdcall (This: IMMDeviceCollection*) -> u32;

    GetCount: fn @stdcall (This: IMMDeviceCollection*, pcDevices: u32*) -> HRESULT;
    Item: fn @stdcall (This: IMMDeviceCollection*, nDevice: u32, ppDevice: IMMDevice**) -> HRESULT;
}

struct IMMDeviceCollection {
    vtable: IMMDeviceCollection_vtable*;
}

struct IMMDevice_vtable {
    QueryInterface: fn @stdcall ( 
        This: IMMDevice*,
        riid: GUID*,
        ppvObject: void**) -> HRESULT;
    
    AddRef: fn @stdcall (This: IMMDevice*) -> u32;
    
    Release: fn @stdcall (This: IMMDevice*) -> u32;
    
    Activate: fn @stdcall (
        This: IMMDevice*,
        iid: GUID*,
        dwClsCtx: u32,
        pActivationParams: PROPVARIANT*,
        ppInterface: void**) -> HRESULT;
    
    OpenPropertyStore: fn @stdcall ( 
        This: IMMDevice*,
        stgmAccess: u32,
        ppProperties: IPropertyStore**) -> HRESULT;
    
    GetId: fn @stdcall (
        This: IMMDevice*,
        ppstrId: u16**) -> HRESULT;
    
    GetState: fn @stdcall (
        This: IMMDevice*,
        pdwState: u32*) -> HRESULT;
}
struct IMMDevice {
    vtable: IMMDevice_vtable*;
}

