
/*
    WASAPI is awful, writing bindings for vtables suck.
*/

#load "ole32.lib" as OLE32

#import "Windows"
#import "Asserts"

struct GUID {
    data0: u32;
    data1: u16;
    data2: u16;
    data3: u64;
}
struct PROPERTYKEY {
    guid: GUID;
    pid: u32;
}
fn PrepareGUID(guid: GUID*, text: char[]) {
    ptr := cast<u8*>guid
    head := 0
    yes: bool
    val: u64

    // NOTE: The 3 first integers (seperated by dash) are stored in little endian while the last 2 are stored in big endian
    val, yes = parse_hex(&head, text, true) // true to flip for little endian
    guid.data0 = val
    head++ // skip '-'
    val, yes = parse_hex(&head, text, true)
    guid.data1 = val
    head++ // skip '-'
    val, yes = parse_hex(&head, text, true)
    guid.data2 = val
    head++ // skip '-'

    val, yes = parse_hex(&head, text, false) // false to not flip for big endian
    head++ // skip '-'
    guid.data3 = val
    val, yes = parse_hex(&head, text, false)
    head++ // skip '-'
    guid.data3 |= val << 16

    // log(guid)
}
fn PreparePKEY(pkey: PROPERTYKEY*, text: char[], pid: u32) {
    PrepareGUID(&pkey.guid, text)
    pkey.pid = pid
}

