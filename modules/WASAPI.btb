}
#macro WAVE_FORMAT_PCM 1
#macro WAVE_FORMAT_EXTENSIBLE 0xFFFE
struct @no_padding WAVEFORMATEX {
    wFormatTag: u16;
    nChannels: u16;
    nSamplesPerSec: u32;
    nAvgBytesPerSec: u32;
    nBlockAlign: u16;
    wBitsPerSample: u16;
    cbSize: u16;
}
struct @no_padding WAVEFORMATEXTENSIBLE {
    Format: WAVEFORMATEX;
    // language doesn't support unions
    //   union {
    //     WORD wValidBitsPerSample;
    //     WORD wSamplesPerBlock;
    //     WORD wReserved;
    //   } Samples;
    union_word: u16;
    dwChannelMask: u32;
    SubFormat: GUID;
}

struct IAudioClient_vtable {
    // Generated by ChatGPT
    QueryInterface: fn @stdcall (This: IAudioClient*, riid: GUID*, ppvObject: void**) -> HRESULT;
    AddRef: fn @stdcall (This: IAudioClient*) -> u32;
    Release: fn @stdcall (This: IAudioClient*) -> u32;
    Initialize: fn @stdcall (This: IAudioClient*, ShareMode: u32, StreamFlags: u32, BufferDuration: i64, Periodicity: i64, pFormat: WAVEFORMATEX*, AudioSessionGuid: GUID*) -> HRESULT;
    GetBufferSize: fn @stdcall (This: IAudioClient*, pNumBufferFrames: u32*) -> HRESULT;
    GetStreamLatency: fn @stdcall (This: IAudioClient*, phnsLatency: i64*) -> HRESULT;
    GetCurrentPadding: fn @stdcall (This: IAudioClient*, pNumPaddingFrames: u32*) -> HRESULT;
    IsFormatSupported: fn @stdcall (This: IAudioClient*, ShareMode: u32, pFormat: WAVEFORMATEX*, ppClosestMatch: WAVEFORMATEX**) -> HRESULT;
    GetMixFormat: fn @stdcall (This: IAudioClient*, ppDeviceFormat: WAVEFORMATEX**) -> HRESULT;
    GetDevicePeriod: fn @stdcall (This: IAudioClient*, phnsDefaultDevicePeriod: i64*, phnsMinimumDevicePeriod: i64*) -> HRESULT;
    Start: fn @stdcall (This: IAudioClient*) -> HRESULT;
    Stop: fn @stdcall (This: IAudioClient*) -> HRESULT;
    Reset: fn @stdcall (This: IAudioClient*) -> HRESULT;
    SetEventHandle: fn @stdcall (This: IAudioClient*, eventHandle: HANDLE) -> HRESULT;
    GetService: fn @stdcall (This: IAudioClient*, riid: GUID*, ppv: void**) -> HRESULT;
}
struct IAudioClient {
    vtable: IAudioClient_vtable*;
}

