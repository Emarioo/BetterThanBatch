    AUDCLNT_E_EFFECT_NOT_AVAILABLE         = 0x88890041,
    AUDCLNT_E_EFFECT_STATE_READ_ONLY       = 0x88890042,
    AUDCLNT_S_BUFFER_EMPTY                 = 0x08890001, // these are "success", no severity meaning sign bit should be 0
    AUDCLNT_S_THREAD_ALREADY_REGISTERED    = 0x08890002,
    AUDCLNT_S_POSITION_STALLED             = 0x08890003,

    E_NOINTERFACE = 0x80004002, 
    E_POINTER     = 0x80004003,
    E_INVALIDARG  = 0x80070057,
    E_OUTOFMEMORY = 0x8007000E,
    E_NOTFOUND    = 0x80070490,
    
};


